<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg">
<ImageView android:id="@+id/logo" android:layout_width="match_parent" android:layout_height="145dp" android:src="@drawable/hits20_logo" android:scaleType="fitCenter"/>
<TextView android:id="@+id/live" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● EN VIVO" android:gravity="center" android:textColor="#FFFFFF" android:textStyle="bold"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RADIO LISTA" android:gravity="center" android:textColor="#8FEFFF"/>
<com.hits20radio.online.AudioSpectrumView android:id="@+id/spectrum" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
<TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HITS20 RADIO ONLINE" android:gravity="center" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="60dp"><Button android:id="@+id/radioBtn" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="📻 RADIO"/><Button android:id="@+id/videoBtn" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="📺 VIDEO"/></LinearLayout>
<Button android:id="@+id/play" android:layout_width="match_parent" android:layout_height="58dp" android:text="▶ ESCUCHAR HITS20"/>
<SeekBar android:id="@+id/volume" android:layout_width="match_parent" android:layout_height="45dp" android:max="100" android:progress="85"/>
<Button android:id="@+id/settings" android:layout_width="match_parent" android:layout_height="50dp" android:text="⚙ CONFIGURACIÓN"/>
</LinearLayout>